# ============ 镜像配置（必填） ============
# 通过 docker images 命令查询，格式为 REPOSITORY:TAG
STUDIO_CONSOLE_IMAGE=studio-console:1.0.0.20260526091150.x86_64
STUDIO_MANAGER_IMAGE=studio-manager:1.0.0.20260526091150.x86_64
STUDIO_SERVICE_IMAGE=studio-service:1.0.0.20260526091150.x86_64
STUDIO_RUNTIME_IMAGE=studio-runtime:1.0.0.20260526091150.x86_64

# ============ 数据库配置（必填） ============
# 数据库名需与实际创建的数据库名一致
SPRING_DATASOURCE_URL=jdbc:mariadb://${MYSQL_DB_IP}:3306/agent_studio?allowMultiQueries=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=

# ============ Redis配置（必填） ============
# 无密码时 REDIS_PASSWORD 留空
REDIS_HOST=${REDIS_HOST}
REDIS_PASSWORD=
REDIS_PORT=6379

# ============ 对象存储配置（必填） ============
# 默认端口9000为MinIO的S3 API端口，华为云OBS使用443端口
# OBS_BUCKET 需提前在对象存储中创建
OBS_URL=https://${OBS_IP}:9000
OBS_BUCKET=agent-builder
OBS_AK=
OBS_SK=

# ============ Java服务HTTPS证书配置（可选，默认忽略） ============
# 启用HTTPS时设 SERVER_SSL_ENABLED=true，并填写以下证书配置
SERVER_SSL_ENABLED=false
CB_CF_SERVER_KEYSTORE=
CB_CF_TRUST_KEYSTORE=
SERVER_SSL_TRUST_STORE_PASSWORD=
SERVER_SSL_KEY_STORE_PASSWORD=
SERVER_SSL_KEY_PASSWORD=

# ============ studio-runtime HTTPS证书配置（可选，默认忽略） ============
HTTPS_CERT_FILE=
HTTPS_KEY_FILE=
TLS_CERT_KEY_PASSWD=

# ============ OpenSearch配置（记忆库向量存储，启用记忆库时必填） ============
# 格式: host:port，多节点用逗号分隔，如 host1:9200,host2:9200
OPENSEARCH_HOSTS=
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_USE_SSL=false
OPENSEARCH_SSL_VERIFY=false

# ============ 记忆库功能配置（可选，默认关闭） ============
# 总开关，设为true启用记忆库功能
MEMORY_ENABLED=false
LONG_TERM_MEMORY_ENABLE=false
MEMORY_USER_PROFILE_ENABLE=false

# 记忆库抽取用的Embedding模型配置（启用记忆库时必填）
MEMORY_EMBEDDING_MODEL=bge-m3
MEMORY_EMBEDDING_BASE_URL=
MEMORY_EMBEDDING_API_KEY=

# 记忆库抽取用的LLM模型配置（启用记忆库时必填）
MEMORY_LLM_MODEL=
MEMORY_LLM_BASE_URL=
MEMORY_LLM_API_KEY=

# ============ 记忆库MySQL存储配置（启用记忆库时必填） ============
# 记忆库文本数据存储，可与主库共用同一MySQL实例，使用独立数据库
MEMORY_DB_HOST=
MEMORY_DB_PORT=3306
MEMORY_DB_USER=
MEMORY_DB_PASSWORD=
MEMORY_DB_NAME=agent-memory
