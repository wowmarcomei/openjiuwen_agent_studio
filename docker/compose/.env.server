IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=wowmarcomei/openjiuwen-agent-studio
IMAGE_TAG=latest

STUDIO_CONSOLE_IMAGE=${IMAGE_REGISTRY}/${IMAGE_NAMESPACE}/studio-console:${IMAGE_TAG}
STUDIO_MANAGER_IMAGE=${IMAGE_REGISTRY}/${IMAGE_NAMESPACE}/studio-manager:${IMAGE_TAG}
STUDIO_SERVICE_IMAGE=${IMAGE_REGISTRY}/${IMAGE_NAMESPACE}/studio-service:${IMAGE_TAG}
STUDIO_RUNTIME_IMAGE=${IMAGE_REGISTRY}/${IMAGE_NAMESPACE}/studio-runtime:${IMAGE_TAG}

MYSQL_IMAGE=${IMAGE_REGISTRY}/${IMAGE_NAMESPACE}/mysql:8.0
REDIS_IMAGE=${IMAGE_REGISTRY}/${IMAGE_NAMESPACE}/redis:7
MINIO_IMAGE=${IMAGE_REGISTRY}/${IMAGE_NAMESPACE}/minio/minio
MINIO_MC_IMAGE=${IMAGE_REGISTRY}/${IMAGE_NAMESPACE}/minio/mc

SPRING_DATASOURCE_URL=jdbc:mariadb://mysql:3306/agent-builder?allowMultiQueries=true&useUnicode&characterEncoding=UTF-8&autoReconnect=true&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=123456

REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

OBS_URL=http://localhost:9000
OBS_BUCKET=agent-builder
OBS_AK=minioadmin
OBS_SK=minioadmin

SERVER_SSL_ENABLED=false
CB_CF_SERVER_KEYSTORE=
CB_CF_TRUST_KEYSTORE=
SERVER_SSL_TRUST_STORE_PASSWORD=
SERVER_SSL_KEY_STORE_PASSWORD=
SERVER_SSL_KEY_PASSWORD=

HTTPS_CERT_FILE=
HTTPS_KEY_FILE=
TLS_CERT_KEY_PASSWD=

AGENT_RUNTIME_ENDPOINT=http://studio-service:31113
AGENT_MANAGER_ENDPOINT=http://studio-manager:31111
USER_AUTH_ENDPOINT=http://studio-manager:31111
