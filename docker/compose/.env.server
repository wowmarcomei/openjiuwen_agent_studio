###############################################################################
# Image source
###############################################################################
# This file is consumed by deploy-server.sh. The script exports the selected
# application image names before invoking docker compose.
# Choose where application images are pulled from:
#   ghcr      -> ghcr repo, one image per service:
#                ${GHCR_IMAGE_REPOSITORY}/studio-manager:${IMAGE_TAG}
#   dockerhub -> Docker Hub repo, one repo with service-prefixed tags:
#                ${DOCKERHUB_IMAGE_REPOSITORY}:studio-manager-${IMAGE_TAG}
#   custom    -> use explicit STUDIO_*_IMAGE values below
IMAGE_SOURCE=ghcr
IMAGE_TAG=latest

GHCR_IMAGE_REPOSITORY=ghcr.io/xd-ys/openjiuwen_agent_studio
DOCKERHUB_IMAGE_REPOSITORY=wowmarcomei/openjiuwen_agent_studio

# Controls only the four Studio application images. Infrastructure images keep
# if_not_present in docker-compose-server.yml.
# Online deployment can keep always. Offline deployment should use never after
# loading application images locally.
APP_IMAGE_PULL_POLICY=always

# Optional registry credentials. Leave blank for public images.
GHCR_USERNAME=
GHCR_TOKEN=
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# Only required when IMAGE_SOURCE=custom.
# STUDIO_CONSOLE_IMAGE=
# STUDIO_MANAGER_IMAGE=
# STUDIO_SERVICE_IMAGE=
# STUDIO_RUNTIME_IMAGE=

###############################################################################
# Infrastructure images
###############################################################################
MYSQL_IMAGE=mysql:8.0
REDIS_IMAGE=redis:7
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest

###############################################################################
# Infrastructure settings
###############################################################################
SPRING_DATASOURCE_URL=jdbc:mariadb://mysql:3306/agent-builder?allowMultiQueries=true&useUnicode&characterEncoding=UTF-8&autoReconnect=true&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=123456

REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

OBS_URL=http://minio:9000
OBS_BUCKET=agent-builder
OBS_AK=minioadmin
OBS_SK=minioadmin

###############################################################################
# Service endpoints
###############################################################################
AGENT_RUNTIME_ENDPOINT=http://studio-service:31113
AGENT_MANAGER_ENDPOINT=http://studio-manager:31111
USER_AUTH_ENDPOINT=http://studio-manager:31111

###############################################################################
# TLS settings. Defaults keep HTTP enabled for local/single-node deployment.
###############################################################################
SERVER_SSL_ENABLED=false
CB_CF_SERVER_KEYSTORE=
CB_CF_TRUST_KEYSTORE=
SERVER_SSL_TRUST_STORE_PASSWORD=
SERVER_SSL_KEY_STORE_PASSWORD=
SERVER_SSL_KEY_PASSWORD=

HTTPS_CERT_FILE=
HTTPS_KEY_FILE=
TLS_CERT_KEY_PASSWD=

###############################################################################
# Post-start verification endpoints. Leave blank to use script defaults.
###############################################################################
FRONTEND_URL=
NGINX_HEALTH_URL=
KEY_API_URL=
