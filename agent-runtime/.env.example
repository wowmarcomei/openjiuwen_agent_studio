# ========================================
# Server Configuration
# ========================================
SERVER_HOST=127.0.0.1
SERVER_PORT=31014
LOG_LEVEL=INFO

# ========================================
# Workflow Logger Configuration
# ========================================
# 控制 workflow_logger 的日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
# WORKFLOW_LOG_LEVEL=INFO

# HTTPS Configuration (optional)
HTTPS=false
TLS_CERT_PATH=
TLS_CERT_KEY_PATH=
TLS_CERT_KEY_PASSWD=

# ========================================
# Redis Configuration
# ========================================
REDIS_MODE=single
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# Cluster mode configuration (optional)
# REDIS_CLUSTER_NODES=host1:6379,host2:6379,host3:6379

# Sentinel mode configuration (optional)
# REDIS_SENTINEL_MASTER=mymaster
# REDIS_SENTINEL_NODES=host1:26379,host2:26379

# ========================================
# LLM Configuration
# ========================================
MODEL_ROUTER_API=http://127.0.0.1:31113/v1/agent-builder

# ========================================
# Object Storage (OBS) Configuration
# ========================================
# Optional: for reading IR files from OBS
DATASOURCE_OBS_SERVER=
DATASOURCE_OBS_BUCKET=
DATASOURCE_OBS_AK=
DATASOURCE_OBS_SK=
DATASOURCE_OBS_ENABLE_SSL=false