# Integration test environment configuration
# Copy this file to test_config.env and fill in real values.
# test_config.env is gitignored — never commit real credentials.

# DashScope Embedding
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
EMBEDDING_API_KEY=your-embedding-api-key

# DashScope LLM
LLM_MODEL=deepseek-v4-pro
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your-llm-api-key

# OpenSearch
OPENSEARCH_HOSTS=https://127.0.0.1:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=your-opensearch-password

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
